rules_version = '2';

// AI assistance was used for implementation support.
//
// Trip photos live at trips/{tripId}/photos/{photoId}.jpg. Only members of the trip can read them
// or add one, and a photo cannot be changed or deleted by clients. Membership is the member
// document that Firestore holds for the trip (see firestore.rules).
service firebase.storage {
  match /b/{bucket}/o {

    function isMember(tripId) {
      return request.auth != null
          && firestore.exists(/databases/(default)/documents/trips/$(tripId)/members/$(request.auth.uid));
    }

    match /trips/{tripId}/photos/{photoId} {
      allow read: if isMember(tripId);

      // The uploader recorded in the metadata must be the signed-in user. The size limit leaves room
      // for a full-resolution phone photo.
      allow create: if isMember(tripId)
          && request.resource.contentType == 'image/jpeg'
          && request.resource.size < 15 * 1024 * 1024
          && request.resource.metadata.uploadedBy == request.auth.uid;

      allow update, delete: if false;
    }
  }
}
